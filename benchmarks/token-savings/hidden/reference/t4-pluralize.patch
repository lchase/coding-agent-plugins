+def pluralize(count: int, singular: str, plural: str | None = None) -> str:
+    """Return a count plus the singular or plural form of a word.
+
+    ``pluralize(1, "file")`` is ``"1 file"``. ``pluralize(2, "file")`` is
+    ``"2 files"``. ``pluralize(0, "file")`` is ``"0 files"``. Pass ``plural``
+    to override the default of appending ``s`` (``pluralize(3, "child",
+    "children")`` is ``"3 children"``). A count of 1 always uses ``singular``.
+    Negative counts raise ``ValueError``.
+    """
+    if count < 0:
+        raise ValueError("count must be non-negative")
+    if count == 1:
+        word = singular
+    elif plural is not None:
+        word = plural
+    else:
+        word = singular + "s"
+    return f"{count} {word}"
+
